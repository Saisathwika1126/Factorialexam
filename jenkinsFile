pipeline{
    agent any
    stages{
        stage('Compile'){
            steps{
                sh 'javac Factorial.java TestFactorial.java'
            }
        }
        stage('Test'){
            steps{
                sh 'java TestFactorial'
            }
        }
        stage('Run'){
            steps{
                sh 'java Factorial'
            }
        }
        stage('Package JAR'){
            steps{
                sh 'jar cfm factorial.jar manifest.txt Factorial.class'
            }
        }
        stage('Archive JAR'){
            steps{
                archiveArtifacts artifacts: 'factorial.jar'
            }
        }
    }
    post{
        success{
            echo 'built artifacts successfully.'
        }
        failure{
            echo 'build or test failed.'
        }
    }
}
